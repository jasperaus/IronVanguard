{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "player"] },
        "wins": { "type": "number" },
        "losses": { "type": "number" }
      },
      "required": ["uid", "displayName", "role"]
    },
    "Game": {
      "title": "Game Session",
      "description": "Active tactical game session",
      "type": "object",
      "properties": {
        "players": { "type": "array", "items": { "type": "string" } },
        "turn": { "type": "number" },
        "activePlayerId": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "playing", "finished"] },
        "winnerId": { "type": "string" },
        "lastAction": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["players", "turn", "activePlayerId", "status"]
    },
    "Mech": {
      "title": "Mech Instance",
      "description": "A single mech on the battlefield",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["light", "medium", "heavy"] },
        "ownerId": { "type": "string" },
        "position": {
          "type": "object",
          "properties": {
            "q": { "type": "number" },
            "r": { "type": "number" }
          },
          "required": ["q", "r"]
        },
        "stats": {
          "type": "object",
          "properties": {
            "hp": { "type": "number" },
            "maxHp": { "type": "number" },
            "armor": { "type": "number" },
            "maxArmor": { "type": "number" },
            "movement": { "type": "number" },
            "range": { "type": "number" },
            "damage": { "type": "number" },
            "heat": { "type": "number" },
            "maxHeat": { "type": "number" }
          },
          "required": ["hp", "maxHp", "armor", "maxArmor"]
        },
        "isDestroyed": { "type": "boolean" },
        "hasMoved": { "type": "boolean" },
        "hasAttacked": { "type": "boolean" }
      },
      "required": ["type", "ownerId", "position", "stats"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Game session state"
    },
    "/games/{gameId}/mechs/{mechId}": {
      "schema": "Mech",
      "description": "Mechs within a specific game"
    }
  }
}
